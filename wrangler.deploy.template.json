{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahoraga-halal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "FEATURE_LLM_RESEARCH": "true",
    "FEATURE_OPTIONS": "false",
    "ALPACA_PAPER": "true",
    "DEFAULT_MAX_POSITION_PCT": "0.10",
    "DEFAULT_MAX_NOTIONAL_PER_TRADE": "none",
    "DEFAULT_MAX_DAILY_LOSS_PCT": "0.02",
    "DEFAULT_COOLDOWN_MINUTES": "30",
    "DEFAULT_MAX_OPEN_POSITIONS": "10",
    "DEFAULT_APPROVAL_TTL_SECONDS": "300"
  },
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/api", "/api/*", "/agent", "/agent/*", "/mcp", "/mcp/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "MCP_AGENT", "class_name": "MahoragaMcpAgent" },
      { "name": "MAHORAGA_HARNESS", "class_name": "MahoragaHarness" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO", "MahoragaMcpAgent", "MahoragaHarness"] }],
  "triggers": { "crons": ["*/5 13-20 * * 1-5", "0 14 * * 1-5", "30 21 * * 1-5", "0 5 * * *", "0 * * * *"] },
  "build": { "command": "npm run build" }
}
