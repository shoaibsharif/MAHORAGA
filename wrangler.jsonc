// Used by Cloudflare's Git deploys and by `wrangler dev`.
// Resource IDs are left out on purpose: `wrangler deploy` binds to the D1 database
// and R2 bucket with these names (creating them if missing) and creates the KV namespace.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahoraga",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Fail the deploy rather than ship without source maps.
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    // Traffic is a few cron runs and dashboard calls, so every trace is kept.
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "FEATURE_LLM_RESEARCH": "true",
    "FEATURE_OPTIONS": "false",
    "ALPACA_PAPER": "true",
    "DEFAULT_MAX_POSITION_PCT": "0.10",
    "DEFAULT_MAX_NOTIONAL_PER_TRADE": "none",
    "DEFAULT_MAX_DAILY_LOSS_PCT": "0.02",
    "DEFAULT_COOLDOWN_MINUTES": "30",
    "DEFAULT_MAX_OPEN_POSITIONS": "10",
    "DEFAULT_APPROVAL_TTL_SECONDS": "300"
  },
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/api", "/api/*", "/agent", "/agent/*", "/mcp", "/mcp/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "mahoraga-db", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "CACHE" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "mahoraga-artifacts" }],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "MAHORAGA_HARNESS", "class_name": "MahoragaHarness" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO", "MahoragaMcpAgent", "MahoragaHarness"] },
    // The MCP server is stateless now; this drops the old per-session Durable Object and its storage.
    { "tag": "v2", "deleted_classes": ["MahoragaMcpAgent"] }
  ],
  "triggers": { "crons": ["*/5 13-20 * * 1-5", "0 14 * * 1-5", "30 21 * * 1-5", "0 5 * * *", "0 * * * *"] }
}
