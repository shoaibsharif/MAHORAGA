{
  "name": "mahoraga",
  "version": "0.3.0",
  "description": "Cloudflare Workers MCP server for autonomous stock trading with Alpaca",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "build:cloudflare": "npm run typecheck && npm run test:run && npm ci --prefix dashboard && npm run build --prefix dashboard",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "wrangler d1 execute DB --local --command 'SELECT 1'",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "setup:access": "npx tsx scripts/setup-access.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/cohere": "^4.0.68",
    "@ai-sdk/deepseek": "^3.0.72",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/groq": "^4.0.69",
    "@ai-sdk/mistral": "^4.0.71",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/xai": "^5.0.29",
    "@minimax-ai/ai-sdk-provider": "0.0.1",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.33.0",
    "ai": "^7.0.152",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild": false,
    "workerd": false,
    "fsevents": false,
    "core-js-pure": false
  }
}
